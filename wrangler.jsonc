{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sakurun",
  "main": "src/index.tsx",
  "compatibility_date": "2026-06-14",
  "compatibility_flags": ["nodejs_compat"],
  "ai": {
    "binding": "AI"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CounterAgent",
        "class_name": "CounterAgent"
      },
      {
        "name": "SakurunAgent",
        "class_name": "SakurunAgent"
      },
      {
        "name": "MagiAgent",
        "class_name": "MagiAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["CounterAgent"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["SakurunAgent"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["MagiAgent"]
    }
  ]
}
